---json
{
  "title": "Intermynd Instruments — Workflow-first musical instruments",
  "description": "Workflow-first instruments for the connected mind. Explore DS-8 Drumstream, a drum synthesizer, sampler, sequencer, and performance groovebox for PS Vita.",
  "ogTitle": "Intermynd Instruments — Workflow-first instruments",
  "ogDescription": "Explore DS-8 Drumstream for PS Vita and the workflow-first approach behind Intermynd Instruments.",
  "twitterTitle": "Intermynd Instruments — Workflow-first instruments",
  "twitterDescription": "Explore DS-8 Drumstream for PS Vita and the workflow-first approach behind Intermynd Instruments.",
  "permalink": "/index.html",
  "reveal": true,
  "navLinks": [
    {
      "href": "#products",
      "label": "Products"
    },
    {
      "href": "#approach",
      "label": "Approach"
    },
    {
      "href": "#development",
      "label": "In development"
    }
  ],
  "navCta": {
    "href": "#interest",
    "label": "Hardware updates"
  },
  "footerColumns": [
    {
      "label": "Navigate",
      "links": [
        {
          "href": "#products",
          "label": "Products"
        },
        {
          "href": "#approach",
          "label": "Approach"
        },
        {
          "href": "#development",
          "label": "In development"
        }
      ]
    },
    {
      "label": "Connect",
      "links": [
        {
          "href": "https://intermynd.redbubble.com",
          "label": "Official merch shop",
          "external": true
        },
        {
          "href": "https://github.com/intermynd-instruments",
          "label": "GitHub",
          "external": true
        },
        {
          "href": "https://github.com/intermynd-instruments/psvita-usb-audio-midi",
          "label": "Open-source USB plugin",
          "external": true
        },
        {
          "href": "https://www.youtube.com/@intermynd-instruments",
          "label": "Subscribe on YouTube",
          "external": true
        }
      ]
    },
    {
      "label": "Stay in touch",
      "links": [
        {
          "href": "#interest",
          "label": "Hardware interest"
        }
      ]
    }
  ]
}
---
{% extends "layouts/base.njk" %}

{% block body %}
{% raw %}
  <!-- Hero -->
  <section class="pt-16 relative bg-[#6f26de]">
    <div class="absolute inset-0 dot-grid"></div>
    <div class="w-full px-3 lg:px-16 pt-6 pb-24 relative z-10">
      <div>
        <span class="hero-blink text-[#b4b4b4] text-xl sm:text-2xl mb-4 block">■</span>
        <h1 class="mb-8 sm:mb-12">
          <img src="/assets/intermynd-logotype-white.svg" alt="Intermynd Instruments" class="w-full max-w-[64rem] h-auto">
        </h1>
        <p class="text-lg sm:text-xl lg:text-2xl text-white max-w-2xl sm:max-w-none sm:whitespace-nowrap mb-4 font-light leading-relaxed uppercase">
          Workflow-first instruments for the connected mind.
        </p>
        <p class="text-sm sm:text-base text-[#b4b4b4] max-w-xl mb-12 leading-relaxed">
          Start with DS-8: an eight-track drum synthesizer, sampler, sequencer, and performance groovebox for PS Vita. More instruments are in development.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/ds8.html" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black font-semibold rounded-full hover:bg-[#b4b4b4] transition-colors text-sm">
            Explore DS-8
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#approach" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-[#b4b4b4] text-white hover:border-white hover:text-white transition-all text-sm font-semibold">
            Our approach
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Products Grid -->
  <section id="products" class="border-t border-[#b4b4b4] bg-black scroll-mt-20 fade-section">
    <div class="w-full px-3 lg:px-16 pt-24 pb-14 bg-white">
      <p class="text-xs font-semibold text-[#6f26de] tracking-[0.2em] uppercase mb-4 terminal-label">
        <span class="term-slash text-[#b4b4b4]">/</span> <span class="term-text text-[#6f26de]" style="--char-count: 8">Products</span> <span class="term-block text-[#6f26de]">■</span>
      </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-3 text-black">DS-8 available now. More instruments taking shape.</h2>
      <p class="text-black max-w-2xl leading-relaxed text-sm sm:text-base">
        Download the complete PS Vita groovebox today, or preview the hardware instruments currently in development.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-0 bg-black products-grid products-grid--catalog w-full px-2">
        <!-- Drumstream -->
        <div class="group">
          <div class="aspect-square flex items-center justify-center bg-black p-6 sm:p-8 lg:p-10 relative overflow-hidden">
            <img src="/ds8.png" alt="DS-8 Drumstream" class="w-full h-full object-contain transition-opacity duration-300 group-hover:opacity-0">
            <img src="/ds8.png" alt="DS-8 Drumstream zoomed" class="absolute inset-0 w-full h-full object-contain p-2 sm:p-3 lg:p-4 opacity-0 scale-150 transition-opacity duration-300 group-hover:opacity-100">
          </div>
          <div class="border-t border-[#b4b4b4]"></div>
          <div class="p-6 sm:p-8 lg:p-10">
            <span class="text-[10px] font-bold tracking-[0.15em] uppercase text-[#6f26de]">Drum Machine</span>
            <h3 class="text-2xl sm:text-3xl font-bold text-white mt-2 mb-2">DS-8 Drumstream</h3>
            <p class="text-sm text-[#b4b4b4] mb-4 leading-relaxed">Eight-track drum synthesis, sampling, sequencing, arranging, and Live&nbsp;&nbsp;FX in one portable PS Vita workflow.</p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              <span class="text-[10px] font-semibold tracking-[0.1em] uppercase text-[#b4b4b4] bg-black border border-[#b4b4b4] px-2.5 py-1">Homebrew</span>
              <span class="text-[10px] font-semibold tracking-[0.1em] uppercase text-[#b4b4b4] bg-black border border-[#b4b4b4] px-2.5 py-1">PS Vita</span>
            </div>
            <div class="flex items-end justify-between gap-4">
              <div>
                <span class="text-xl sm:text-2xl font-bold text-white">Free download</span>
                <p class="text-xs text-[#b4b4b4] mt-1">Available on Itch.io</p>
              </div>
              <a href="/ds8.html" class="inline-flex items-center px-6 py-2.5 bg-[#6f26de] text-white text-xs font-bold tracking-[0.15em] uppercase whitespace-nowrap hover:bg-white hover:text-black transition-colors rounded-full">Find out more</a>
            </div>
          </div>
        </div>
        <!-- Polydeck -->
        <div class="group polydeck-group">
          <div class="aspect-square flex items-center justify-center bg-[#dfdfdf] p-6 sm:p-8 lg:p-10 relative overflow-hidden">
            <img src="/pd12-top.jpeg" alt="Polydeck" class="polydeck-top w-full h-full object-contain transition-opacity duration-300 group-hover:opacity-0">
            <img src="/pd12-closeup.jpeg" alt="Polydeck closeup" class="polydeck-closeup absolute inset-0 w-full h-full object-contain p-4 sm:p-5 lg:p-6 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            <div class="absolute left-1/2 -translate-x-1/2 bottom-3 flex gap-2 z-10">
              <button class="color-dot w-4 h-4 rounded-full border-2 border-white bg-black ring-2 ring-[#6f26de]" data-color="black" aria-label="Black finish"></button>
              <button class="color-dot w-4 h-4 rounded-full border-2 border-black bg-white" data-color="white" aria-label="White finish"></button>
            </div>
          </div>
          <div class="border-t border-[#b4b4b4]"></div>
          <div class="p-6 sm:p-8 lg:p-10">
            <span class="text-[10px] font-bold tracking-[0.15em] uppercase text-[#6f26de]">Performance Controller</span>
            <h3 class="text-2xl sm:text-3xl font-bold text-white mt-2 mb-2">Polydeck</h3>
            <p class="text-sm text-[#b4b4b4] mb-4 leading-relaxed">A broader performance surface without giving up portability, clarity, or a modern control experience.</p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              <span class="text-[10px] font-semibold tracking-[0.1em] uppercase text-[#b4b4b4] bg-black border border-[#b4b4b4] px-2.5 py-1">Bluetooth</span>
              <span class="text-[10px] font-semibold tracking-[0.1em] uppercase text-[#b4b4b4] bg-black border border-[#b4b4b4] px-2.5 py-1">MIDI TRS A</span>
              <span class="text-[10px] font-semibold tracking-[0.1em] uppercase text-[#b4b4b4] bg-black border border-[#b4b4b4] px-2.5 py-1">USB MIDI</span>
            </div>
            <div class="flex items-end justify-between gap-4">
              <div>
                <span class="text-xl sm:text-2xl font-bold text-white">More info soon</span>
              </div>
              <a href="#interest" data-preorder-product="Polydeck" class="inline-flex items-center px-6 py-2.5 bg-[#6f26de] text-white text-xs font-bold tracking-[0.15em] uppercase whitespace-nowrap hover:bg-white hover:text-black transition-colors rounded-full">Register interest</a>
            </div>
          </div>
        </div>
        <!-- Kaiser-1 -->
        <div>
          <div class="aspect-square flex items-center justify-center">
            <span class="text-7xl sm:text-8xl lg:text-7xl xl:text-9xl font-black text-[#b4b4b4] tracking-tight select-none">K-1</span>
          </div>
          <div class="border-t border-[#b4b4b4]"></div>
          <div class="p-6 sm:p-8 lg:p-10">
            <span class="text-[10px] font-bold tracking-[0.15em] uppercase text-[#6f26de]">MIDI Scene Launcher</span>
            <h3 class="text-2xl sm:text-3xl font-bold text-white mt-2 mb-2">Kaiser-1</h3>
            <p class="text-sm text-[#b4b4b4] mb-4 leading-relaxed">A dedicated MIDI scene launcher for hardware. Switch between setups, recall scenes, and route control messages across your gear with zero menu diving.</p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              <span class="text-[10px] font-semibold tracking-[0.1em] uppercase text-[#6f26de] bg-white border border-[#6f26de] px-2.5 py-1">In development</span>
            </div>
            <div class="flex items-end justify-between gap-4">
              <div>
                <span class="text-xl sm:text-2xl font-bold text-white">Coming soon</span>
              </div>
              <a href="#interest" data-preorder-product="Kaiser-1" class="inline-flex items-center px-6 py-2.5 bg-white text-black text-xs font-bold tracking-[0.15em] uppercase whitespace-nowrap hover:bg-[#6f26de] hover:text-white transition-colors rounded-full">Register interest</a>
            </div>
          </div>
        </div>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="border-t border-[#b4b4b4] bg-white scroll-mt-20 fade-section">
    <div class="w-full px-3 lg:px-16 py-24">
      <p class="text-xs font-semibold text-[#6f26de] tracking-[0.2em] uppercase mb-4 terminal-label">
        <span class="term-slash text-[#b4b4b4]">/</span> <span class="term-text text-[#6f26de]" style="--char-count: 8">Approach</span> <span class="term-block text-[#6f26de]">■</span>
      </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4 text-black">Built around the musical loop.</h2>
      <p class="text-black max-w-2xl mb-16 leading-relaxed text-sm sm:text-base">
        DS-8 expresses the Intermynd approach: move from the first hit to a complete performance without losing momentum or changing tools.
      </p>
      <div class="grid sm:grid-cols-3 gap-10">
        <div class="border-t border-[#b4b4b4] pt-8">
          <div class="w-10 h-10 rounded-lg bg-white border border-[#6f26de] flex items-center justify-center mb-5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-3 text-black">Immediate control</h3>
          <p class="text-sm text-black leading-relaxed">Make and edit rhythms without interrupting playback. The controls stay close to the musical decision in front of you.</p>
        </div>
        <div class="border-t border-[#b4b4b4] pt-8">
          <div class="w-10 h-10 rounded-lg bg-white border border-[#6f26de] flex items-center justify-center mb-5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-3 text-black">One continuous workflow</h3>
          <p class="text-sm text-black leading-relaxed">Synthesize, sample, sequence, arrange, and perform inside one instrument instead of stitching together disconnected tools.</p>
        </div>
        <div class="border-t border-[#b4b4b4] pt-8">
          <div class="w-10 h-10 rounded-lg bg-white border border-[#6f26de] flex items-center justify-center mb-5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#000000" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M12 8v8M8 12h8"/></svg>
          </div>
          <h3 class="text-lg font-semibold mb-3 text-black">Portable performance</h3>
          <p class="text-sm text-black leading-relaxed">Physical controls, projects, presets, and Live&nbsp;&nbsp;FX keep the full creative and performance workflow inside the Vita.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="border-t border-[#b4b4b4] bg-white fade-section">
    <div class="w-full px-3 lg:px-16 py-24">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs font-semibold text-[#6f26de] tracking-[0.2em] uppercase mb-6 terminal-label">
          <span class="term-slash text-[#b4b4b4]">/</span> <span class="term-text text-[#6f26de]" style="--char-count: 7">Mission</span> <span class="term-block text-[#6f26de]">■</span>
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-6 text-black">From idea to performance, without leaving the instrument.</h2>
        <p class="text-black max-w-xl mx-auto leading-relaxed text-sm sm:text-base">
          Intermynd builds focused musical tools that keep the important actions together. DS-8 starts with rhythm and carries it through sound design, sampling, arrangement, performance, and capture.
        </p>
      </div>
    </div>
  </section>

  <!-- Hardware in Development -->
  <section id="development" class="border-t border-[#b4b4b4] bg-white scroll-mt-20 fade-section">
    <div class="w-full px-3 lg:px-16 py-24">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs font-semibold text-[#6f26de] tracking-[0.2em] uppercase mb-6 terminal-label">
          <span class="term-slash text-[#b4b4b4]">/</span> <span class="term-text text-[#6f26de]" style="--char-count: 14">In development</span> <span class="term-block text-[#6f26de]">■</span>
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-6 text-black">Two hardware instruments taking shape.</h2>
        <p class="text-black max-w-xl mx-auto mb-4 leading-relaxed text-sm sm:text-base">
          Polydeck and Kaiser-1 are early hardware projects built around the same workflow-first idea: clear physical control, focused jobs, and less time in menus.
        </p>
        <p class="text-black max-w-xl mx-auto mb-10 leading-relaxed text-sm sm:text-base">
          Details, availability, and any open-hardware plans will be shared as the designs mature.
        </p>
        <a href="#products" class="inline-flex items-center gap-2 px-6 py-3 bg-[#6f26de] text-white font-semibold rounded-full hover:bg-black transition-colors text-sm">
          See the concepts
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Hardware Interest -->
  <section id="interest" class="border-t border-[#b4b4b4] bg-white scroll-mt-20 fade-section">
    <div class="w-full px-3 lg:px-16 py-24">
      <div class="max-w-2xl mx-auto">
        <p class="text-xs font-semibold text-[#6f26de] tracking-[0.2em] uppercase mb-6 terminal-label">
          <span class="term-slash text-[#b4b4b4]">/</span> <span class="term-text text-[#6f26de]" style="--char-count: 17">Hardware interest</span> <span class="term-block text-[#6f26de]">■</span>
        </p>
        <div class="grid lg:grid-cols-[0.95fr_1.05fr] gap-10 items-start">
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-3 text-black">Get updates on Polydeck and Kaiser-1.</h2>
            <p class="text-sm sm:text-base text-black leading-relaxed mb-5">
              This is an interest list, not a preorder. We&rsquo;ll only contact you when there is meaningful progress, availability, or a production update to share.
            </p>
            <ul class="flex flex-col gap-3 text-sm text-black">
              <li class="flex items-start gap-2"><span class="text-[#6f26de] mt-0.5">■</span> Choose the hardware project you want to follow</li>
              <li class="flex items-start gap-2"><span class="text-[#6f26de] mt-0.5">■</span> Tell us where you are based</li>
              <li class="flex items-start gap-2"><span class="text-[#6f26de] mt-0.5">■</span> Hear from us when there is something real to share</li>
            </ul>
          </div>
          <form id="preorder-form" class="bg-white border border-[#b4b4b4] p-5 sm:p-7" novalidate>
            <div class="grid gap-4">
              <div>
                <label for="preorder-product" class="block text-xs font-semibold tracking-[0.15em] uppercase text-black mb-2">Product</label>
                <select id="preorder-product" name="product" required
                  class="w-full bg-white border border-[#b4b4b4] px-4 py-3 text-sm text-black focus:outline-none focus:border-[#6f26de] transition-colors">
                  <option value="Polydeck">Polydeck</option>
                  <option value="Kaiser-1">Kaiser-1</option>
                  <option value="General interest">General interest</option>
                </select>
              </div>
              <div>
                <label for="preorder-country" class="block text-xs font-semibold tracking-[0.15em] uppercase text-black mb-2">Country</label>
                <input id="preorder-country" name="country" type="text" placeholder="Singapore" required
                  class="w-full bg-white border border-[#b4b4b4] px-4 py-3 text-sm text-black placeholder:text-black focus:outline-none focus:border-[#6f26de] transition-colors">
              </div>
              <button type="submit" id="preorder-submit"
                 class="px-6 py-3 bg-[#6f26de] text-white font-semibold hover:bg-black transition-colors text-sm whitespace-nowrap disabled:bg-[#b4b4b4] disabled:text-black disabled:cursor-not-allowed">
                Continue to interest form
              </button>
              <p id="preorder-status" class="min-h-[1.25rem] text-sm text-black" aria-live="polite"></p>
              <p class="text-xs text-black leading-relaxed">
                Your product and country selections will carry over to a short Google Form where you can add your email and submit your interest.
              </p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
{% endraw %}
{% endblock %}

{% block scripts %}{% include "partials/scripts-index.njk" %}{% endblock %}
