<footer class="border-t border-[#b4b4b4] bg-black text-white">
  <div class="w-full px-3 lg:px-16 py-16">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <a href="/" class="flex items-center gap-3">
          <img src="/assets/intermynd-combination-logo-white.svg" alt="Intermynd Instruments" class="h-8 w-auto">
        </a>
        <p class="text-sm text-[#b4b4b4] mt-3">{{ footerNote }}</p>
      </div>
      <div class="flex flex-wrap gap-4 text-sm text-[#b4b4b4]">
        {%- for link in footerLinks %}
        <a href="{{ link.href }}"{% if link.external %} target="_blank" rel="noopener noreferrer"{% endif %} class="hover:text-white transition-colors">{{ link.label }}</a>
        {%- endfor %}
      </div>
    </div>
  </div>
</footer>
