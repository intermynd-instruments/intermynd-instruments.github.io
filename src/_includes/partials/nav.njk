<header class="fixed top-0 left-0 right-0 z-50 bg-[#6f26de]">
  <nav class="w-full px-3 lg:px-16 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center">
      <img src="/assets/intermynd-combination-logo-white.svg" alt="Intermynd Instruments" class="h-8 w-auto">
    </a>
    <div class="hidden md:flex items-center gap-8 text-sm font-medium text-[#b4b4b4]">
      {%- for link in navLinks %}
      <a href="{{ link.href }}" class="hover:text-white transition-colors">{{ link.label }}</a>
      {%- endfor %}
    </div>
    <div class="hidden md:flex items-center gap-4">
      <a href="{{ navCta.href }}"{% if navCta.external %} target="_blank" rel="noopener noreferrer"{% endif %} class="px-4 py-1.5 rounded-full border border-[#b4b4b4] text-white hover:border-white hover:text-white transition-all text-xs font-semibold tracking-wide uppercase">{{ navCta.label }}</a>
    </div>
    <button id="menu-btn" class="md:hidden flex flex-col gap-1.5 w-7 h-7 justify-center items-end z-50" aria-label="Toggle menu">
      <span class="hamburger-line hamburger-top block w-6 h-[2px] bg-white rounded-full"></span>
      <span class="hamburger-line hamburger-mid block w-5 h-[2px] bg-white rounded-full"></span>
      <span class="hamburger-line hamburger-bot block w-6 h-[2px] bg-white rounded-full"></span>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden md:hidden border-t border-[#b4b4b4] bg-[#6f26de]">
    <div class="px-6 py-6 flex flex-col gap-5 text-lg font-medium text-[#b4b4b4]">
      {%- for link in navLinks %}
      <a href="{{ link.href }}" class="hover:text-white transition-colors" onclick="closeMenu()">{{ link.label }}</a>
      {%- endfor %}
      <a href="{{ navCta.href }}"{% if navCta.external %} target="_blank" rel="noopener noreferrer"{% endif %} class="inline-flex self-start px-4 py-2 rounded-full border border-[#b4b4b4] text-white hover:border-white hover:text-white transition-all text-sm font-semibold tracking-wide uppercase" onclick="closeMenu()">{{ navCta.label }}</a>
    </div>
  </div>
</header>
